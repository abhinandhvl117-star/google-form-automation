  "pages": {
    "page_1": {
      "title": "Page 1",
      "questions": {
        "p1_q1": {
          "label": "Gender ",
          "type": "radio",
          "required": true,
          "max_selections": 1,
          "options": [
            "Male",
            "Female",
            "Prefer not to say"
          ]
        },
        "p1_q2": {
          "label": "Age ",
          "type": "text",
          "required": true,
          "validation": {}
        },
        "p1_q3": {
          "label": "Number of dependents (children/ elders)",
          "type": "text",
          "required": true,
          "validation": {}
        },
        "p1_q4": {
          "label": "Marital status ",
          "type": "radio",
          "required": true,
          "max_selections": 1,
          "options": [
            "Single",
            "Married"
          ]
        },
        "p1_q5": {
          "label": "Total work experience in corporative sector",
          "type": "radio",
          "required": true,
          "max_selections": 1,
          "options": [
            "Less than 1 year",
            "1-3 years",
            "3-5 years",
            "6-10 years",
            "More than 10 years"
          ]
        },
        "p1_q6": {
          "label": "Current job level /designation",
          "type": "radio",
          "required": true,
          "max_selections": 1,
          "options": [
